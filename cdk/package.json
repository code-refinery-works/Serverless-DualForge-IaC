{
  "name": "serverless-api-cdk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build":   "tsc",
    "watch":   "tsc -w",
    "cdk":     "cdk",
    "deploy":  "cdk deploy --require-approval never",
    "diff":    "cdk diff",
    "synth":   "cdk synth",
    "lint":    "eslint 'bin/**/*.ts' 'lib/**/*.ts'",
    "nag":     "cdk synth 2>&1 | grep -E '(Error|Warning)'"
  },
  "dependencies": {
    "aws-cdk-lib":                         "^2.140.0",
    "constructs":                          "^10.3.0",
    "source-map-support":                  "^0.5.21"
  },
  "devDependencies": {
    "@types/node":                         "^20.12.0",
    "aws-cdk":                             "^2.140.0",
    "cdk-nag":                             "^2.28.0",
    "esbuild":                             "^0.21.0",
    "typescript":                          "^5.4.0"
  },
  "engines": { "node": ">=20.0.0" }
}